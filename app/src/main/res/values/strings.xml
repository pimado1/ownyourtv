<resources>
    <string name="app_name">OwnYourTV</string>
    <string name="tagline">You paid for it. Own it.</string>
    <string name="w_lead">No ads, no tracking, a home screen that is yours. Everything from the remote, no computer.</string>
    <string name="w_p1">Switch off the ads and tracking your TV came with</string>
    <string name="w_p2">A living home screen, made for your TV</string>
    <string name="w_p3">Change your mind any time: one button puts everything back</string>
    <string name="start">Get started</string>
    <string name="d_title">Unlock your TV in 3 steps</string>
    <string name="d_lead">Android keeps this switch for its owner. It takes a minute, once.</string>
    <string name="d_s1">Open About</string>
    <string name="d_s1b">Settings › System › About</string>
    <string name="d_s2">Click Build 7 times</string>
    <string name="d_s2b">On “Android TV OS build”, until it says you are a developer</string>
    <string name="d_s3">Turn on USB debugging</string>
    <string name="d_s3b">Settings › System › Developer options</string>
    <string name="d_open_about">Open About</string>
    <string name="d_open_dev">Open Developer options</string>
    <string name="d_wait">OwnYourTV carries on by itself as soon as debugging is on.</string>
    <string name="c_title">Say yes to your TV</string>
    <string name="c_lead">A window opens: tick “Always allow from this computer”, then OK.</string>
    <string name="c_why">It is your TV asking whether OwnYourTV may change its settings. Nothing leaves the TV.</string>
    <string name="c_waiting">Waiting for your OK…</string>
    <string name="c_stuck">No window? Turn USB debugging off and on again, then come back here.</string>
    <string name="c_retry">Try again</string>
    <string name="c_no_port">This TV does not open debugging over the network. OwnYourTV cannot work on it yet.</string>
